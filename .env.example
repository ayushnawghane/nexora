APP_NAME=Nexora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laravel Debugbar overlays the bottom of the screen (over the sidebar user menu). Set true only while profiling.
DEBUGBAR_ENABLED=false
APP_URL=http://nexora.test
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexora
DB_USERNAME=root
DB_PASSWORD=

# Read-only legacy beacon-stack database, used only by legacy:import commands.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=beacon_stack
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
# Copy of Stack's uploads folder; the transactions import attaches engagement letter PDFs from it.
LEGACY_UPLOADS_PATH=

# ISIN payment reminders (daily job): days ahead, how long overdue payments stay in the email, send time.
ISIN_REMINDER_DAYS=7
ISIN_REMINDER_OVERDUE_DAYS=30
ISIN_REMINDER_TIME=08:30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@beacontrustee.co.in"
MAIL_FROM_NAME="${APP_NAME}"

# Company lookup (CIN / GST / PAN). Use "fake" locally until UAT credentials are provided.
COMPANY_LOOKUP_DRIVER=fake
# Legacy names in brackets: copy the values from the legacy stack-erp .env.
CODIUM_API_LOGIN_LINK=
CODIUM_API_CIN_LINK=
CODIUM_API_GST_LINK=
CODIUM_API_PAN_LINK=
CODIUM_API_COMPANY_CODE=        # (COMPANY_CODE)
CODIUM_API_PASSWORD=            # (PASSWORD)
CODIUM_API_JWT_SECRET=          # (CIN_GST_PAN_JWT_SECRET) sent as apikey on sign-in
CODIUM_API_SUREPASS_KEY=        # (SURE_PASS_KEY) sent as apikey on lookups
CODIUM_API_STACK_TOKEN=         # (STACK_TOKEN)
CODIUM_API_EMAIL=               # (EMAIL)
CODIUM_API_VERIFY_SSL=true      # (CODIUM_SSL_VERIFY)

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
